  "cards": [
    {
      "dot": "cyan",
      "title": "Edge Ingestion Tier",
      "items": [
        "Web Portal UI (HTML5 / Vanilla JS) exposed externally via NodePort 30500",
        "Flask backend handles multipart PDF ingestion and proxies requests to the scanner",
        "Raw file streamed directly into MinIO S3 inbox-bucket upon receipt"
      ]
    },
    {
      "dot": "emerald",
      "title": "Serverless Compliance Engine",
      "items": [
        "Serverless worker built on Google functions-framework listening on ClusterIP 8080",
        "Extracts in-memory text streams from PDF using pypdf without disk persistence",
        "Inspects Indian PII (Aadhaar, PAN, UPI, IFSC) and Global PII (SSN, Cards, Passports)"
      ]
    },
    {
      "dot": "violet",
      "title": "Storage Tiering & Encryption",
      "items": [
        "MinIO S3-compatible object storage configured with separate isolated tiers",
        "Temporary landing tier (inbox-bucket) is strictly purged after inspection",
        "Cold storage vault (archive-bucket) retains files encrypted using symmetric AES (Fernet)"
      ]
    },
    {
      "dot": "amber",
      "title": "Hybrid Cloud & IaC Governance",
      "items": [
        "Cloud Firestore NoSQL database tracks real-time document compliance records ($0 Spark)",
        "HashiCorp Terraform provisions storage buckets and least-privilege IAM JSON policies",
        "Kubernetes Secrets (firebase-secret) isolate credentials from codebase and container images"
      ]
    }
  ]
